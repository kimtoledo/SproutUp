{
  "name": "@sproutup/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup --config tsup.config.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "provision:initial-admin": "tsx --env-file-if-exists=../../.env src/auth/provision-initial-admin.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.26",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/multipart": "10.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.8.1",
    "@sproutup/db": "*",
    "@sproutup/shared": "*",
    "better-auth": "1.6.26",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.5",
    "@types/node": "20.19.17",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
