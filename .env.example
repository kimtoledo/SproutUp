# API runtime
API_HOST=0.0.0.0
API_PORT=3001
APP_ORIGIN=http://borrower.lvh.me:3000
# Exact browser origins allowed for credentialed API requests and Better Auth.
APP_ORIGINS=http://admin.lvh.me:3000,http://borrower.lvh.me:3000,http://investor.lvh.me:3000,http://localhost:3000
BETTER_AUTH_URL=http://api.lvh.me:3001
# Local shared-cookie parent; use the deployment's real parent domain in hosted environments.
AUTH_COOKIE_DOMAIN=.lvh.me
# Controlled CLI bootstrap only; use secret management outside local development.
PROVISION_ADMIN_NAME=
PROVISION_ADMIN_EMAIL=
PROVISION_ADMIN_PASSWORD=
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://sproutup:sproutup@localhost:5432/sproutup
# How much of X-Forwarded-For to trust for client-IP resolution (rate limits + audit).
# false (default) = trust none / API reached directly. Also accepts: true, a hop
# count (e.g. 1), or a comma-separated proxy IP/CIDR allowlist.
API_TRUST_PROXY=false

# Web runtime
NEXT_PUBLIC_API_URL=http://api.lvh.me:3001
NEXT_PUBLIC_PORTAL_PROTOCOL=http
NEXT_PUBLIC_PORTAL_ROOT_DOMAIN=lvh.me
NEXT_PUBLIC_PORTAL_PORT=3000
